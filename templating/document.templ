package templating

import (
	"rocket-three-starter/config"
	"rocket-three-starter/web/resources"
)

templ Document() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0"/>
			<script type="module" src={ resources.StaticPath("datastar/datastar-rocket.js") }></script>
			<script type="module" src={ resources.StaticPath("rocket/three-component.js") }></script>
			<link href={ resources.StaticPath("css/index.css") } rel="stylesheet" type="text/css"/>
			<script type="importmap">
				{
					"imports": {
						"datastar-rocket": "/static/datastar/datastar-rocket.js",
						"three": "https://cdn.jsdelivr.net/npm/three@0.186.0/build/three.module.js",
						"three/addons/": "https://cdn.jsdelivr.net/npm/three@0.186.0/examples/jsm/"
					}
				}
			</script>
		</head>
		<body>
			if config.Global.Environment == config.Dev {
				<div data-init="@get('/reload', {retryMaxCount: Infinity, retryInterval:200, retryMaxWaitMs:200})"></div>
			}
			{ children... }
		</body>
	</html>
}
